SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-32-char-secret-here

# HR accounts — untuk production gunakan bcrypt hash untuk password
HR_ACCOUNTS=[{"email":"hr@perusahaan.com","password":"password123","nama":"HR Staff","role":"administrator"}]

# Origins yang diizinkan, pisahkan dengan koma
ALLOWED_ORIGINS=https://yourdomain.com
